SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# Production: HTTPS proksi (nginx) orqasida True — SSL redirect, HSTS, secure cookie.
USE_HTTPS=False

# Admin panelga HTTPS orqali kirilsa: https://crm.example.uz
CSRF_TRUSTED_ORIGINS=

# Bitta IP'dan login urinishlari limiti.
LOGIN_THROTTLE_RATE=5/min

DB_NAME=crm
DB_USER=crm
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Docker (ixtiyoriy): portlar band bo'lsa o'zgartiring; gunicorn worker'lari soni.
BACKEND_PORT=8000
DB_PUBLISHED_PORT=5432
GUNICORN_WORKERS=3
